# Docker Images
CONNECTOR_IMAGE=connector:latest
ISSUER_IMAGE=waltid/issuer-api2:1.0.0
NGROK_IMAGE=ngrok/ngrok:3

# Enforce HTTPS via NGrok (false=localhost HTTP, true=ngrok HTTPS)
# false (default): localhost HTTP - for local development
#   Start with: docker-compose up -d
# true: NGrok HTTPS - for production/external testing
#   Start with: docker-compose --profile ngrok up -d
ENFORCE_HTTPS=false

# NGrok Configuration - Required only if ENFORCE_HTTPS=true
# Get auth tokens from: https://dashboard.ngrok.com/get-started/your-authtoken
# Reserve static domains at: https://dashboard.ngrok.com/cloud-edge/domains
# Get auth tokens from: https://dashboard.ngrok.com/get-started/your-authtoken
# Reserve static domains at: https://dashboard.ngrok.com/cloud-edge/domains
PARTY_A_NGROK_AUTHTOKEN=your-party-a-ngrok-auth-token
PARTY_A_NGROK_DOMAIN=your-party-a.ngrok-free.app
PARTY_B_NGROK_AUTHTOKEN=your-party-b-ngrok-auth-token
PARTY_B_NGROK_DOMAIN=your-party-b.ngrok-free.dev

# Party A Connector Keys - Generated EC P-256 keypairs
# Generate new keys: openssl ecparam -name prime256v1 -genkey -noout -out key.pem
PARTY_A_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\r\n<base64-encoded-key>\r\n-----END PRIVATE KEY-----
PARTY_A_WALLET_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\r\n<base64-encoded-key>\r\n-----END PRIVATE KEY-----

# Party B Connector Keys
PARTY_B_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\r\n<base64-encoded-key>\r\n-----END PRIVATE KEY-----
PARTY_B_WALLET_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\r\n<base64-encoded-key>\r\n-----END PRIVATE KEY-----

# Wallet Configuration
WALLET_CREDENTIAL_STORE_PATH=/app/data/credentials
WALLET_STS_CLIENT_ID=dsp-client
WALLET_STS_CLIENT_SECRET=dsp-secret

# ---------------------------------------------------------------------------
# Party C — a Java EDC connector + IdentityHub, for interop testing
# Only used with: docker-compose --profile party-c up -d
# ---------------------------------------------------------------------------
# Built by ./build-party-c.sh from the MinimumViableDataspace launchers. The tag is the
# pinned EDC release; never track a floating tag here, or a rebuild silently changes the
# protocol surface under you.
PARTY_C_CONTROLPLANE_IMAGE=party-c-controlplane:1.0.0-RC1
PARTY_C_DATAPLANE_IMAGE=party-c-dataplane:1.0.0-RC1
PARTY_C_IDENTITYHUB_IMAGE=party-c-identityhub:1.0.0-RC1
PARTY_C_POSTGRES_IMAGE=postgres:17-alpine
PARTY_C_VAULT_IMAGE=hashicorp/vault:1.17
PARTY_C_KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.0
PARTY_C_SEED_IMAGE=alpine:3.21

# Party C's DID resolves to its own IdentityHub inside the compose network, which is why
# party C only works with ENFORCE_HTTPS=false.
PARTY_C_MANAGEMENT_API_KEY=password
PARTY_C_VAULT_TOKEN=root
# Any 32-byte base64 value; shared by the control plane and IdentityHub for encryption.
PARTY_C_AES_KEY=yHo9w6m2KOI3FE7vI+fcN6j86JDQ6V10lJPlv9lLWoE=
PARTY_C_ASSET_ID=party-c-asset-1

# Set to true to generate party C's configs and add it to party A's federation. Requires
# ENFORCE_HTTPS=false.
PARTY_C_ENABLED=false
