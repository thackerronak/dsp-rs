index 253ac33..297c493 100644
--- a/build.gradle.kts
+++ b/build.gradle.kts
@@ -24,6 +24,12 @@ val edcBuildId = libs.plugins.edc.build.get().pluginId
 
 allprojects {
     apply(plugin = edcBuildId)
+
+    // The launcher images run a Java 23 JRE. Without pinning the release, a newer local
+    // JDK emits class files the image refuses to load (UnsupportedClassVersionError).
+    tasks.withType<JavaCompile>().configureEach {
+        options.release.set(23)
+    }
 }
 
 
